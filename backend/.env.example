# Copia este archivo como .env para trabajar en local. En Railway se ponen en "Variables".
DATABASE_URL="postgresql://usuario:password@localhost:5432/tophorses"
JWT_SECRET="pon-aqui-una-clave-larga-y-aleatoria"
FRONTEND_URL="http://localhost:5173"
PORT=3001

# Carpeta de subidas. En Railway: monta un Volume en /data y pon UPLOAD_DIR=/data/uploads
UPLOAD_DIR="./uploads"
# Documentación privada. Por defecto: carpeta hermana de UPLOAD_DIR (en Railway /data/private-docs)
# DOCS_DIR="/data/private-docs"

# Cuenta de dirección (se crea al arrancar)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# IA. Con Claude (api.anthropic.com) se usa su API nativa; con el resto, la API compatible con OpenAI.
AI_BASE_URL="https://api.anthropic.com/v1"
AI_API_KEY=""
AI_MODEL=""
# Segunda IA opcional (doble lectura)
AI2_BASE_URL=""
AI2_API_KEY=""
AI2_MODEL=""
AI_VIDEO_FRAMES=8
AI_VIDEO_BURSTS=2

# Precio del informe en euros (0 = fase de pruebas, sin coste)
INFORME_PRICE_EUR=0

# Stripe (opcional; sin clave, las solicitudes quedan en "pendiente de pago")
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
